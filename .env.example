# LLM-as-Judge 配置
# 用于替代模拟评分，调用真实 LLM API 进行 Agent 多维度评估

# OpenAI API Key（也支持兼容 OpenAI 格式的其他服务，如 Azure, Ollama 等）
# LLM_API_KEY=sk-your-api-key-here

# 备用：也支持传统的 OPENAI_API_KEY 环境变量
# OPENAI_API_KEY=sk-your-api-key-here

# 使用的模型名称（默认 gpt-4o-mini）
# LLM_MODEL=gpt-4o-mini

# 兼容 OpenAI API 格式的 Base URL
# 默认：https://api.openai.com/v1
# 如果使用代理或兼容服务（如 Azure OpenAI, Ollama, vLLM），取消注释并修改：
# LLM_BASE_URL=https://api.openai.com/v1

# LLM 请求超时时间（秒），默认 30
# LLM_TIMEOUT=30

# 最大重试次数，默认 3
# LLM_MAX_RETRIES=3

# 重试间隔（秒），默认 2
# LLM_RETRY_DELAY=2

